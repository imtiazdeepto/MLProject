import sys
sys.path.append('scripts')

from data_loader import load_data
from preprocessing import clean_data, split_data
from train import tune_and_train, save_model
from evaluate import evaluate
from utils import ensure_dirs
import pandas as pd

def main():
    # Create necessary directories
    ensure_dirs(['data', 'models', 'outputs', 'notebooks', 'scripts'])
    
    # 1. Load data
    print("Loading data...")
    df = load_data()
    
    # 2. Clean and preprocess
    print("Cleaning data...")
    df_clean = clean_data(df)
    X = df_clean.drop(columns=['Churn'])
    y = df_clean['Churn']
    
    # 3. Split
    X_train, X_test, y_train, y_test = split_data(X, y)
    
    # Identify column types
    cat_cols = X.select_dtypes(include=['object']).columns.tolist()
    num_cols = X.select_dtypes(include=['int64', 'float64']).columns.tolist()
    
    # 4. Train and tune
    print("Starting hyperparameter tuning...")
    best_model, best_params, best_cv_score = tune_and_train(X_train, y_train, cat_cols, num_cols)
    print("Best CV ROC-AUC:", best_cv_score)
    print("Best parameters:", best_params)
    
    # 5. Save model
    save_model(best_model, 'models/churn_pipeline_tuned.pkl')
    print("Model saved to models/churn_pipeline_tuned.pkl")
    
    # 6. Evaluate on test set
    print("Evaluating on test set...")
    metrics = evaluate(best_model, X_test, y_test)
    print("Test metrics:", metrics)
    
    # Optionally save metrics to a file
    pd.Series(metrics).to_csv('outputs/test_metrics.csv')

if __name__ == '__main__':
    main()
